# Recreated by setup on each computer.
.venv/
.cache/
config.json
.setup-model-state.json

# Generated local files.
__pycache__/
*.py[cod]
.DS_Store
*.log

# Keep personal libraries out of the source repository; demo/ remains tracked.
/Photo/
/Video/

# Private local MLX runtime, weights, trial data and machine-specific agent config.
/.venv-mlx/
/.models/
/.local/
/config.mlx.json
/opencode.json

# Personal setup notes and incompatible local environments.
/LOCAL_MLX.md
/.venv-mlx.incompatible-*/
/index.json
/.local-*/

# MemorySearch local resources: never publish runtime or user data.
/runtime/
/local-config.json
/archive/
/.memorysearch-index/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
