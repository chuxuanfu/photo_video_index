{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-mlx/qwen3.8-27b",
  "default_agent": "media-index",
  "share": "disabled",
  "update": "disable",
  "snapshots": false,
  "formatter": false,
  "lsp": false,
  "websearch": false,
  "warming": false,
  "plugins": [
    "-opencode.provider.*",
    "-opencode.websearch.*"
  ],
  "mcp": {
    "servers": {}
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "local-mlx",
      "effect": "allow"
    },
    {
      "action": "integration.connect",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "integration.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "integration.use",
      "resource": "local-mlx",
      "effect": "allow"
    },
    {
      "action": "mcp.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plugin.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch.use",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".local/smoke/agent-note.txt",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": ".venv-mlx/bin/python local_workflow.py synthetic",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": ".venv-mlx/bin/python local_workflow.py trial",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": ".venv-mlx/bin/python single_library.py build",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": ".venv-mlx/bin/python media_library.py status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": ".venv-mlx/bin/python media_library.py analyze --limit 5",
      "effect": "allow"
    }
  ],
  "providers": {
    "local-mlx": {
      "name": "Local MLX vision only",
      "env": [],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local-only",
        "timeout": 300000
      },
      "body": {
        "enable_thinking": false
      },
      "models": {
        "qwen3.8-27b": {
          "modelID": "@MODEL_PATH@",
          "name": "Qwen3.8 27B MLX 4bit (local vision)",
          "limit": {
            "context": 32768,
            "output": 2048
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          }
        }
      }
    }
  },
  "agents": {
    "media-index": {
      "description": "Local bounded media-index workflow",
      "mode": "primary",
      "model": "local-mlx/qwen3.8-27b",
      "steps": 3,
      "system": "Use only the fixed allowed local commands. Never run directory-discovery commands or access an unselected media root, access network services, install plugins, share, invoke subagents or use cloud providers. For status run .venv-mlx/bin/python media_library.py status. For an explicitly requested bounded batch run .venv-mlx/bin/python media_library.py analyze --limit 5 exactly once. Set the shell timeout to 600000 milliseconds for indexing workflows. Report only verified aggregate counts and stop after a passed result. Never claim all media are analyzed or verified from a catalog count. For synthetic testing use local_workflow.py synthetic exactly once."
    }
  }
}
